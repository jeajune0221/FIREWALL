# DEV.md 28번 항목: API Key는 Backend 환경 변수에만 저장한다.
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.

OPENAI_API_KEY=sk-your-key-here

# Vision / 콘텐츠 생성 모델 (Responses API + Structured Output 지원 모델)
OPENAI_MODEL=gpt-4.1-mini

# 음성 인식 모델 (P1 기능)
OPENAI_STT_MODEL=whisper-1

# 배포용: 장인(운영자) 화면과 유료 API를 보호하는 비밀번호.
# 값을 비워두면 인증 없이 전체 공개되므로 로컬 개발에서만 비워둔다.
# 사용자명은 maker 고정. 관람객의 /exhibit/<id> 열람에는 영향이 없다.
MAKER_PASSWORD=

# 배포용: 사진과 공개된 전시 데이터를 저장할 영구 디스크 경로 (Railway 볼륨 마운트 경로).
POTTERY_DATA_DIR=
